{
	"name": "obsidian-ytranscript",
	"version": "1.4.0",
	"description": "Fetch and display YouTube transcripts inside Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "jest",
		"lint": "eslint . --max-warnings 0",
		"check": "npm run lint && npm test && npm run build && npm run check-format",
		"check-format": "prettier --check src tests",
		"format": "prettier --write src tests"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.6.0",
		"esbuild": "^0.28.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"jest": "^30.5.2",
		"obsidian": "^1.12.3",
		"prettier": "^3.8.3",
		"ts-jest": "^29.1.2",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.0"
	}
}
